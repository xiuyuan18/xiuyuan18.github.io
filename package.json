{
  "name": "academic-homepage",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "homepage": "https://xiuyuan18.github.io",
  "scripts": {
    "dev": "next dev --turbo",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "serve": "npx serve@latest dist",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
